		{"id":"474c84a6a2bb4a6c","fromNode":"20e0c2f54e134395","fromSide":"bottom","toNode":"c98216ba7fe04948","toSide":"top","label":"foothold → final goal"},
		{"id":"35f3f968fee54dcb","fromNode":"3103e33b6f6f4cb2","fromSide":"bottom","toNode":"490f61d3f21d422b","toSide":"top","label":"PowerShell fetches the RAT"},
		{"id":"0082b1214bb64da3","fromNode":"490f61d3f21d422b","fromSide":"bottom","toNode":"7163a4b4ca39465b","toSide":"top","label":"RAT connects back"},
		{"id":"33ce0492a6854ed3","fromNode":"7163a4b4ca39465b","fromSide":"bottom","toNode":"39202052b3bb4bed","toSide":"top","label":"keep the RAT alive"},
		{"id":"80f577e711874859","fromNode":"39202052b3bb4bed","fromSide":"bottom","toNode":"2cebfdef3a9443ad","toSide":"top","label":"operator collects"},
		{"id":"7030e0427c374a56","fromNode":"2cebfdef3a9443ad","fromSide":"bottom","toNode":"df0291f693c642eb","toSide":"top","label":"foothold → final goal"},
